CONFIG_ARM=y
CONFIG_ARCH_MX6=y
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_SYS_MEMTEST_START=0x80000000
CONFIG_SYS_MEMTEST_END=0x87f00000
CONFIG_ENV_SIZE=0x2000
CONFIG_MX6UL=y
CONFIG_TARGET_MX6UL_ONYX=y
CONFIG_TEXT_BASE=0x82000000
CONFIG_DM_GPIO=y
CONFIG_DEFAULT_DEVICE_TREE="imx6ul-onyx"
CONFIG_DEFAULT_FDT_FILE="imx6ul-onyx.dtb"
CONFIG_SUPPORT_RAW_INITRD=y
# CONFIG_ANDROID_BOOT_IMAGE is not set
# CONFIG_BOOTSTD is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv stdin usbacm; setenv stdout usbacm; setenv stderr usbacm; echo RECOVERY_READY"
CONFIG_BOOTDELAY=-2
# CONFIG_CONSOLE_MUX is not set
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_HUSH_PARSER=y
CONFIG_SYS_MAXARGS=32
CONFIG_SYS_PBSIZE=532
CONFIG_CMD_BOOTZ=y
CONFIG_SYS_BOOTM_LEN=0x1000000
CONFIG_CMD_GPIO=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_CRC32=y
# CONFIG_CMD_SAVEENV is not set
CONFIG_CMD_FASTBOOT=y
CONFIG_OF_CONTROL=y
CONFIG_ENV_OVERWRITE=y
CONFIG_ENV_IS_NOWHERE=y
CONFIG_SYS_RELOC_GD_ENV_ADDR=y
# CONFIG_NET is not set
# CONFIG_MMC is not set
CONFIG_DM_SERIAL=y
CONFIG_MXC_UART=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_IMX6=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_MXC=y
CONFIG_VIDEO=y
# CONFIG_VIDEO_LOGO is not set
CONFIG_VIDEO_MXS=y
CONFIG_VIDEO_BPP32=y
CONFIG_BMP_24BPP=y
CONFIG_IMX_THERMAL=y
CONFIG_USB=y
CONFIG_USB_MAX_CONTROLLER_COUNT=1
CONFIG_CI_UDC=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="unfr0zen"
CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
CONFIG_USB_GADGET_PRODUCT_NUM=0x4ee2
CONFIG_USB_FUNCTION_ACM=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x84000000
CONFIG_FASTBOOT_BUF_SIZE=0x02000000
CONFIG_NEST_USB_RECOVERY=y
# CONFIG_LDO_BYPASS_CHECK is not set
# CONFIG_FSL_FASTBOOT is not set
# CONFIG_FASTBOOT_UUU_SUPPORT is not set
CONFIG_CMD_CYCLIC=y
CONFIG_LMB=y
CONFIG_LMB_USE_MAX_REGIONS=y
CONFIG_LMB_MAX_REGIONS=16
# CONFIG_EFI_LOADER is not set
CONFIG_FIT=y
CONFIG_CMD_IMI=y
CONFIG_CMD_GO=y
CONFIG_CMD_NAND=y
CONFIG_CMD_NAND_TRIMFFS=y
CONFIG_CMD_NANDBCB=y
CONFIG_CMD_MTDPARTS=y
CONFIG_MTDIDS_DEFAULT="nand0=gpmi-nand"
CONFIG_CMD_UBI=y
CONFIG_CMD_UBIFS=y
CONFIG_MTD=y
CONFIG_DM_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_NAND_MXS=y
CONFIG_NAND_MXS_DT=y
CONFIG_SYS_NAND_ONFI_DETECTION=y

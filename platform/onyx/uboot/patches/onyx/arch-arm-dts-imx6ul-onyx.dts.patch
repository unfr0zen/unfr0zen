diff --git a/arch/arm/dts/imx6ul-onyx.dts b/arch/arm/dts/imx6ul-onyx.dts
new file mode 100644
index 00000000000..cb86e2488c4
--- /dev/null
+++ b/arch/arm/dts/imx6ul-onyx.dts
@@ -0,0 +1,163 @@
+/* Recovery for the Nest Thermostat E: console UART and the USB gadget the
+ * host talks to, with GPMI NAND for backup and the installed UBI volumes. */
+/dts-v1/;
+
+#include "imx6ul.dtsi"
+
+/ {
+	model = "Nest Thermostat E (onyx) recovery";
+	compatible = "nest,onyx", "fsl,imx6ul";
+
+	chosen {
+		stdout-path = &uart1;
+	};
+
+	memory {
+		reg = <0x80000000 0x08000000>;
+	};
+};
+
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart1>;
+	status = "okay";
+};
+
+&usbotg1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <>;
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbg2 {
+	status = "disabled";
+};
+
+&usdhc1 {
+	status = "disabled";
+};
+
+&usdhc2 {
+	status = "disabled";
+};
+
+&qspi {
+	status = "disabled";
+};
+
+&gpmi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_gpmi>;
+	/* The chip's reported ECC requirement, checked against the UBI
+	 * partition's erase counter headers before any access. */
+	fsl,use-minimum-ecc;
+	nest,probe-ubi-offset = <0x400000>;
+	nand-on-flash-bbt;
+	status = "okay";
+};
+
+&i2c2 {
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c2>;
+	status = "okay";
+};
+
+&lcdif {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_lcdif>;
+	display = <&display>;
+	status = "okay";
+
+	display: display {
+		bits-per-pixel = <24>;
+
+		display-timings {
+			timing-320x320 {
+				clock-frequency = <8088000>;
+				hactive = <320>;
+				vactive = <320>;
+				hback-porch = <20>;
+				hfront-porch = <50>;
+				vback-porch = <6>;
+				vfront-porch = <8>;
+				hsync-len = <10>;
+				vsync-len = <2>;
+				hsync-active = <1>;
+				vsync-active = <1>;
+				de-active = <1>;
+				pixelclk-active = <1>;
+			};
+		};
+	};
+};
+
+&iomuxc {
+	pinctrl_i2c2: i2c2grp {
+		fsl,pins = <
+			MX6UL_PAD_GPIO1_IO00__I2C2_SCL 0x40001808
+			MX6UL_PAD_GPIO1_IO01__I2C2_SDA 0x40001808
+		>;
+	};
+
+	pinctrl_lcdif: lcdifgrp {
+		fsl,pins = <
+			MX6UL_PAD_LCD_DATA00__LCDIF_DATA00 0x1008
+			MX6UL_PAD_LCD_DATA01__LCDIF_DATA01 0x1008
+			MX6UL_PAD_LCD_DATA02__LCDIF_DATA02 0x1008
+			MX6UL_PAD_LCD_DATA03__LCDIF_DATA03 0x1008
+			MX6UL_PAD_LCD_DATA04__LCDIF_DATA04 0x1008
+			MX6UL_PAD_LCD_DATA05__LCDIF_DATA05 0x1008
+			MX6UL_PAD_LCD_DATA06__LCDIF_DATA06 0x1008
+			MX6UL_PAD_LCD_DATA07__LCDIF_DATA07 0x1008
+			MX6UL_PAD_LCD_DATA08__LCDIF_DATA08 0x1008
+			MX6UL_PAD_LCD_DATA09__LCDIF_DATA09 0x1008
+			MX6UL_PAD_LCD_DATA10__LCDIF_DATA10 0x1008
+			MX6UL_PAD_LCD_DATA11__LCDIF_DATA11 0x1008
+			MX6UL_PAD_LCD_DATA12__LCDIF_DATA12 0x1008
+			MX6UL_PAD_LCD_DATA13__LCDIF_DATA13 0x1008
+			MX6UL_PAD_LCD_DATA14__LCDIF_DATA14 0x1008
+			MX6UL_PAD_LCD_DATA15__LCDIF_DATA15 0x1008
+			MX6UL_PAD_LCD_DATA16__LCDIF_DATA16 0x1008
+			MX6UL_PAD_LCD_DATA17__LCDIF_DATA17 0x1008
+			MX6UL_PAD_LCD_DATA18__LCDIF_DATA18 0x1008
+			MX6UL_PAD_LCD_DATA19__LCDIF_DATA19 0x1008
+			MX6UL_PAD_LCD_DATA20__LCDIF_DATA20 0x1008
+			MX6UL_PAD_LCD_DATA21__LCDIF_DATA21 0x1008
+			MX6UL_PAD_LCD_DATA22__LCDIF_DATA22 0x1008
+			MX6UL_PAD_LCD_DATA23__LCDIF_DATA23 0x1008
+			MX6UL_PAD_LCD_CLK__LCDIF_CLK 0x1008
+			MX6UL_PAD_LCD_ENABLE__LCDIF_ENABLE 0x1008
+			MX6UL_PAD_LCD_VSYNC__LCDIF_VSYNC 0x1008
+			MX6UL_PAD_LCD_HSYNC__LCDIF_HSYNC 0x1008
+		>;
+	};
+
+	pinctrl_gpmi: gpmigrp {
+		fsl,pins = <
+			MX6UL_PAD_NAND_CLE__RAWNAND_CLE 0xb0b1
+			MX6UL_PAD_NAND_ALE__RAWNAND_ALE 0xb0b1
+			MX6UL_PAD_NAND_WP_B__RAWNAND_WP_B 0xb0b1
+			MX6UL_PAD_NAND_READY_B__RAWNAND_READY_B 0xb0b1
+			MX6UL_PAD_NAND_CE0_B__RAWNAND_CE0_B 0xb0b1
+			MX6UL_PAD_NAND_RE_B__RAWNAND_RE_B 0xb0b1
+			MX6UL_PAD_NAND_WE_B__RAWNAND_WE_B 0xb0b1
+			MX6UL_PAD_NAND_DATA00__RAWNAND_DATA00 0xb0b1
+			MX6UL_PAD_NAND_DATA01__RAWNAND_DATA01 0xb0b1
+			MX6UL_PAD_NAND_DATA02__RAWNAND_DATA02 0xb0b1
+			MX6UL_PAD_NAND_DATA03__RAWNAND_DATA03 0xb0b1
+			MX6UL_PAD_NAND_DATA04__RAWNAND_DATA04 0xb0b1
+			MX6UL_PAD_NAND_DATA05__RAWNAND_DATA05 0xb0b1
+			MX6UL_PAD_NAND_DATA06__RAWNAND_DATA06 0xb0b1
+			MX6UL_PAD_NAND_DATA07__RAWNAND_DATA07 0xb0b1
+		>;
+	};
+
+	pinctrl_uart1: uart1grp {
+		fsl,pins = <
+			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX 0x1b0b1
+			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX 0x1b0b1
+		>;
+	};
+};

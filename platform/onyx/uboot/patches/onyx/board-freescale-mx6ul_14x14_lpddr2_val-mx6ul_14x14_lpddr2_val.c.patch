+#if defined(CONFIG_TARGET_MX6UL_ONYX) && defined(CONFIG_NEST_USB_RECOVERY)
+static void recovery_watchdog_service(void *ctx)
+{
+	struct watchdog_regs *wdog = (void *)WDOG1_BASE_ADDR;
+
+	writew(0x5555, &wdog->wsr);
+	writew(0xaaaa, &wdog->wsr);
+}
+
+static void recovery_watchdog_start(void)
+{
+	struct watchdog_regs *wdog = (void *)WDOG1_BASE_ADDR;
+	const u16 timeout = CONFIG_WATCHDOG_TIMEOUT_MSECS / 500 - 1;
+
+	writew(SET_WCR_WT(timeout) | WCR_WDE | WCR_SRS | WCR_WDA, &wdog->wcr);
+	recovery_watchdog_service(NULL);
+}
+
+int board_usb_console_ready(void)
+{
+	static struct cyclic_info *watchdog;
+
+	/* Leave the initial deadline in place until the host opens ACM. */
+	if (!watchdog) {
+		watchdog = cyclic_register(recovery_watchdog_service, 100000,
+					   "recovery-watchdog", NULL);
+		if (!watchdog)
+			return -ENOMEM;
+	}
+	recovery_watchdog_service(NULL);
+	return 0;
+}
+#endif
+

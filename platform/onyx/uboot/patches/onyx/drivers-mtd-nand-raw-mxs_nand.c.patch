+#define MXS_NAND_UBI_EC_MAGIC	0x55424923
+#define MXS_NAND_UBI_EC_CRC_LEN	60
+/* Erase counter headers a geometry must decode, of the blocks scanned. */
+#define MXS_NAND_PROBE_HEADERS	8
+#define MXS_NAND_PROBE_BLOCKS	64
+/* Pages that fail any geometry: factory bad blocks among those scanned. */
+#define MXS_NAND_PROBE_FAILURES	2
+
+static char mxs_nand_geometry[64] = "unchecked";
+
+const char *mxs_nand_geometry_state(void)
+{
+	return mxs_nand_geometry;
+}
+
+/*
+ * The first page of the block at @offs: 1 when it decodes cleanly into a
+ * UBI erase counter header, 0 when it is erased, -1 otherwise.
+ */
+static int mxs_nand_probe_block(struct mtd_info *mtd, loff_t offs, u8 *buf)
+{
+	size_t len = 0;
+	u32 i;
+	int ret;
+
+	ret = mtd_read(mtd, offs, mtd->writesize, &len, buf);
+	if ((ret < 0 && ret != -EUCLEAN) || len != mtd->writesize)
+		return -1;
+	for (i = 0; i < mtd->writesize && buf[i] == 0xff; i++)
+		;
+	if (i == mtd->writesize)
+		return 0;
+	if (get_unaligned_be32(buf) != MXS_NAND_UBI_EC_MAGIC)
+		return -1;
+	if ((crc32(0, buf, MXS_NAND_UBI_EC_CRC_LEN) ^ 0xffffffff) !=
+	    get_unaligned_be32(buf + MXS_NAND_UBI_EC_CRC_LEN))
+		return -1;
+	return 1;
+}
+
+static void mxs_nand_use_geometry(struct mtd_info *mtd,
+				  const struct bch_geometry *geo)
+{
+	struct nand_chip *nand = mtd_to_nand(mtd);
+	struct mxs_nand_info *nand_info = nand_get_controller_data(nand);
+
+	nand_info->bch_geometry = *geo;
+	mxs_nand_program_bch(mtd);
+	nand->ecc.size = geo->ecc_chunkn_size;
+	nand->ecc.strength = geo->ecc_strength;
+	mtd->ecc_step_size = geo->ecc_chunkn_size;
+	mtd->ecc_strength = geo->ecc_strength;
+	mtd->bitflip_threshold = DIV_ROUND_UP(geo->ecc_strength * 3, 4);
+}
+
+/*
+ * Keeps the BCH geometry the unit's own system wrote with: the chip's
+ * reported ECC requirement is not always the one its kernel decoded, and a
+ * mismatched layout reads every page as uncorrectable and writes pages the
+ * system cannot read. Each candidate must decode the UBI partition's erase
+ * counter headers cleanly. Without one that does, the NAND is left
+ * read-only and its bad block table untouched, since rebuilding it needs a
+ * readable one.
+ */
+static void mxs_nand_verify_geometry(struct mtd_info *mtd, loff_t start)
+{
+	struct nand_chip *nand = mtd_to_nand(mtd);
+	struct mxs_nand_info *nand_info = nand_get_controller_data(nand);
+	const struct bch_geometry chosen = nand_info->bch_geometry;
+	/* The most the OOB holds: the legacy layout. */
+	const unsigned int most = ((mtd->oobsize - MXS_NAND_METADATA_SIZE) * 8 /
+				   (13 * (mtd->writesize / SZ_512))) & ~1U;
+	struct bch_geometry geo;
+	unsigned int i, strength, block, headers, failures;
+	u8 *buf;
+
+	buf = malloc(mtd->writesize);
+	/* The chip's reported layout, then the legacy one, then the rest. */
+	for (i = 0; buf && i <= most / 2; i++) {
+		strength = i ? most + 2 - 2 * i : chosen.ecc_strength;
+		if (i && strength == chosen.ecc_strength)
+			continue;
+		geo = chosen;
+		if (mxs_nand_calc_ecc_layout_by_info(&geo, mtd, strength,
+						     SZ_512))
+			continue;
+		mxs_nand_use_geometry(mtd, &geo);
+		headers = 0;
+		failures = 0;
+		for (block = 0; block < MXS_NAND_PROBE_BLOCKS &&
+		     headers < MXS_NAND_PROBE_HEADERS &&
+		     failures <= MXS_NAND_PROBE_FAILURES; block++) {
+			int found = mxs_nand_probe_block(mtd,
+				start + (loff_t)block * mtd->erasesize, buf);
+
+			headers += found > 0;
+			failures += found < 0;
+		}
+		printf("NAND: BCH%u/512: %u UBI headers, %u unreadable\n",
+		       geo.ecc_strength, headers, failures);
+		if (headers >= MXS_NAND_PROBE_HEADERS &&
+		    failures <= MXS_NAND_PROBE_FAILURES) {
+			snprintf(mxs_nand_geometry, sizeof(mxs_nand_geometry),
+				 "verified bch%u/512", geo.ecc_strength);
+			free(buf);
+			return;
+		}
+	}
+	free(buf);
+	mxs_nand_use_geometry(mtd, &chosen);
+	mtd->flags &= ~MTD_WRITEABLE;
+	nand->options |= NAND_SKIP_BBTSCAN;
+	snprintf(mxs_nand_geometry, sizeof(mxs_nand_geometry),
+		 "unverified: oob %u, bch2-%u/512 tried", mtd->oobsize, most);
+	printf("NAND: no geometry reads the UBI partition; read-only\n");
+}

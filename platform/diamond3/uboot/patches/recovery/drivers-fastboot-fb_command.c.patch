+/**
+ * upload() - Send RAM at fastboot_buf_addr to the host ("fastboot get_staged")
+ *
+ * @cmd_parameter: Pointer to command parameter
+ * @response: Pointer to fastboot response buffer
+ *
+ * Sends $fastboot_upload_size bytes (hex) if set, else the last download.
+ * The USB function streams the data after this DATA response.
+ */
+static void upload(char *cmd_parameter, char *response)
+{
+	u32 size = env_get_hex("fastboot_upload_size", fastboot_bytes_received);
+
+	if (!size || size > fastboot_buf_size) {
+		fastboot_fail("upload size outside the buffer", response);
+		return;
+	}
+	fastboot_upload_size = size;
+	fastboot_response("DATA", response, "%08x", size);
+}

+/*
+ * Recovery reports on the USB console, which an exception usually takes down
+ * with it. Keep the first exception of each run in OCRAM, which survives the
+ * watchdog reset, for the host to read over ROM SDP:
+ *   0x938100 0xE7C0DE00 | type (1 undef, 2 swi, 3 prefetch, 4 data, 5 unused,
+ *            6 fiq, 7 irq), then the run nonce (0x938058), pc, lr, sp, cpsr,
+ *            DFSR, DFAR, IFSR, IFAR, gd->reloc_off, r0-r3, exception count
+ *   0x938140 32 words from sp
+ */
+#define RECOVERY_EXC	((u32 *)0x00938100)
+
+static void recovery_record(u32 type, struct pt_regs *regs)
+{
+	u32 *rec = RECOVERY_EXC;
+	u32 nonce = *(u32 *)0x00938058;
+	u32 *stack = (u32 *)regs->ARM_sp;
+	u32 dfsr, dfar, ifsr, ifar;
+	int i;
+
+	if (!IS_ENABLED(CONFIG_NEST_USB_RECOVERY))
+		return;
+	if ((rec[0] & 0xFFFFFF00) == 0xE7C0DE00 && rec[1] == nonce) {
+		rec[15]++;	/* keep the first exception of this run */
+		return;
+	}
+	asm volatile("mrc p15, 0, %0, c5, c0, 0" : "=r" (dfsr));
+	asm volatile("mrc p15, 0, %0, c6, c0, 0" : "=r" (dfar));
+	asm volatile("mrc p15, 0, %0, c5, c0, 1" : "=r" (ifsr));
+	asm volatile("mrc p15, 0, %0, c6, c0, 2" : "=r" (ifar));
+	rec[1] = nonce;
+	rec[2] = regs->ARM_pc;	/* raw: data abort +8, undef/prefetch +4 */
+	rec[3] = regs->ARM_lr;
+	rec[4] = regs->ARM_sp;
+	rec[5] = regs->ARM_cpsr;
+	rec[6] = dfsr;
+	rec[7] = dfar;
+	rec[8] = ifsr;
+	rec[9] = ifar;
+	rec[10] = gd->reloc_off;
+	rec[11] = regs->ARM_r0;
+	rec[12] = regs->ARM_r1;
+	rec[13] = regs->ARM_r2;
+	rec[14] = regs->ARM_r3;
+	rec[15] = 1;
+	/* Only copy a stack that is plausibly DDR, 4-byte aligned. */
+	if ((ulong)stack >= 0x80000000 && (ulong)stack < 0xA0000000 - 128 &&
+	    !((ulong)stack & 3))
+		for (i = 0; i < 32; i++)
+			rec[16 + i] = stack[i];
+	rec[0] = 0xE7C0DE00 | type;
+}
+

+#define PANEL_MOSI	IMX_GPIO_NR(4, 16)
+#define PANEL_MISO	IMX_GPIO_NR(4, 17)
+#define PANEL_CS	IMX_GPIO_NR(4, 22)
+#define PANEL_RESET	IMX_GPIO_NR(3, 27)
+#define BL_ENABLE	IMX_GPIO_NR(2, 14)
+
+#define SPI_PAD_CTRL	0x100b1		/* the kernel's ecspi1grp-1 */
+#define RESET_PAD_CTRL	0x1b0b0		/* the kernel's lcdifctrlgrp-0 */
+
+static iomux_v3_cfg_t const display_pads[] = {
+	MX6_PAD_QSPI1A_SCLK__GPIO4_IO_21 | MUX_PAD_CTRL(SPI_PAD_CTRL),
+	MX6_PAD_QSPI1A_DATA0__GPIO4_IO_16 | MUX_PAD_CTRL(SPI_PAD_CTRL),
+	MX6_PAD_QSPI1A_DATA1__GPIO4_IO_17 | MUX_PAD_CTRL(SPI_PAD_CTRL),
+	MX6_PAD_QSPI1A_SS0_B__GPIO4_IO_22 | MUX_PAD_CTRL(NO_PAD_CTRL),
+	MX6_PAD_LCD1_RESET__GPIO3_IO_27 | MUX_PAD_CTRL(RESET_PAD_CTRL),
+	MX6_PAD_KEY_COL4__GPIO2_IO_14 | MUX_PAD_CTRL(NO_PAD_CTRL),
+};
+
+struct hx8369_cmd {
+	u8 cmd;
+	u8 len;
+	u8 data[34];
+	u16 delay_ms;
+};
+
+static const struct hx8369_cmd hx8369_setextc = { 0xb9, 3, { 0xff, 0x83, 0x69 }, 10 };
+

+
+/*
+ * Corrects one flipped bit per byte, data or parity, as the boot ROM
+ * does when it reads the FCB. Returns the bits corrected, or -1 for a
+ * byte the code cannot account for.
+ */
+static int decode_hamming_13_8(void *_src, const void *_ecc, size_t size)
+{
+	int bit, corrected = 0;
+	size_t i;
+	u8 *src = _src;
+	const u8 *ecc = _ecc;
+
+	for (i = 0; i < size; i++) {
+		u8 syndrome = calculate_parity_13_8(src[i]) ^ ecc[i];
+
+		if (!syndrome)
+			continue;
+		/* One parity bit flipped: the data byte is sound. */
+		if (!(syndrome & (syndrome - 1))) {
+			corrected++;
+			continue;
+		}
+		for (bit = 0; bit < 8; bit++)
+			if (calculate_parity_13_8(1 << bit) == syndrome)
+				break;
+		if (bit == 8)
+			return -1;
+		src[i] ^= 1 << bit;
+		corrected++;
+	}
+
+	return corrected;
+}

#!/bin/sh
# unfr0zen initramfs /init (unfr0zen.py --initramfs).
#
# Mounts the root volume named by unfr0zen.slot= read-only, loads that
# volume's own USB gadget modules the way its usb-gadget script does, and
# serves a shell on the ACM gadget for the host to drive. The host decides
# every write, then hands the unit over to the volume's own init on this
# kernel (InitramfsShell::hand_over) or restarts it. Nothing here feeds the
# watchdog: if anything hangs, it resets the unit.
/bin/busybox mkdir -p /sbin /usr/bin /usr/sbin
/bin/busybox --install -s
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

fail() {
    echo "unfr0zen initramfs: $*" >/dev/kmsg
    sleep 5
    reboot -f
}

cmdline=$(cat /proc/cmdline)
product=
[ -f /board-init.sh ] || fail "missing board initialization"
# shellcheck source=/dev/null
. /board-init.sh

slot=$(printf '%s\n' "$cmdline" | sed -n 's/.*unfr0zen\.slot=\(root[01]\).*/\1/p')
[ -n "$slot" ] || fail "no unfr0zen.slot= on the kernel command line"
mount -t ubifs -o ro "ubi0:$slot" /mnt || fail "cannot mount ubi0:$slot"
# The kernel's own module requests (usbfunc:acm) run /sbin/modprobe too.
ln -s /mnt/lib/modules /lib/modules
modprobe usb_f_acm || fail "cannot load usb_f_acm"
modprobe g_acm_ms idVendor=0x0525 idProduct="$product" luns=1 removable=1 ||
    fail "cannot load g_acm_ms"
for _ in $(seq 30); do
    [ -c /dev/ttyGS0 ] && break
    sleep 1
done
[ -c /dev/ttyGS0 ] || fail "no /dev/ttyGS0"
stty -F /dev/ttyGS0 raw -echo

# Starts the volume's own init as the kernel would at a boot from NAND, the
# host's shell having left the root volume read-write with nothing mounted on
# it (InitramfsShell::prepare_hand_over): devtmpfs on its /dev and neither
# /proc nor /sys, and no gadget of this initramfs's for its own.
hand_over() {
    kill -KILL -1
    # ttyGS0 keeps its settings in u_serial, which stays loaded: the
    # firmware's shell there expects a fresh line's, not this raw one.
    stty -F /dev/ttyGS0 sane
    # The gadget stays in use until the killed shell has let go of ttyGS0.
    for _ in $(seq 10); do
        rmmod g_acm_ms 2>/dev/null && break
        sleep 1
    done
    [ ! -d /sys/module/g_acm_ms ] || fail "cannot unload g_acm_ms"
    mount --move /dev /mnt/dev || fail "cannot move /dev"
    umount /sys
    umount /proc
    exec switch_root /mnt /sbin/init
}

# Through a pipe the shell is not interactive: no prompts in its output.
# The host's last command ends the pipe once it asked for the hand-over.
while [ ! -e /hand-over ]; do
    cat /dev/ttyGS0 | sh >/dev/ttyGS0 2>&1
done
hand_over

--- a/ezsp-spi-serial-controller-autoselect.h
+++ b/ezsp-spi-serial-controller-autoselect.h
@@ -147,9 +147,9 @@
 // P[0].1 - MISO
 // P[0].2 - SCLK
 // P[0].3 - nSSEL (IRQC)
-// P[1].2 - nHOST_INT
+// P[1].2 and P[1].4 - nHOST_INT (Nest gen2; the SDK has P[1].2 alone)

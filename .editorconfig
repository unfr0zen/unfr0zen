root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{lua,yml,yaml,json,js,mjs,css,html,md,toml}]
indent_size = 2

[{Makefile,*.patch}]
indent_style = tab

# The shell scripts, which shfmt reads this for.
[{*.sh,*.init,initramfs-init,zigcc,zigcxx}]
switch_case_indent = true
